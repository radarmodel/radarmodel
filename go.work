go 1.24.0

use .

// Local only (in .gitignore): this workspace can't reach vanity import paths,
// so they are served from GitHub clones. CI uses the real module proxy.
replace (
	filippo.io/edwards25519 => /tmp/drv/vanity/edwards25519
	golang.org/x/sys => /tmp/drv/vanity/sys
	golang.org/x/crypto => /tmp/drv/stub/crypto
	golang.org/x/sync => /tmp/drv/stub/sync
	golang.org/x/text => /tmp/drv/stub/text
	golang.org/x/net => /tmp/drv/stub/net
	golang.org/x/term => /tmp/drv/stub/term
	lukechampine.com/adiantum => /tmp/drv/stub/adiantum
)
